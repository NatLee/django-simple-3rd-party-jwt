include pyproject.toml
include *.md
include *.sh
include *.ps1
include LICENSE
# Only the file types the project keeps in git, so whatever a local run leaves behind
# (compiled files, the example's db.sqlite3, logs) never ends up in the sdist.
recursive-include src *.py *.html
recursive-include tests *.py
recursive-include example *.py *.html *.js *.css *.txt *.sh *.ps1
